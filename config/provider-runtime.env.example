# Names only. Supply actual values outside Git. Default remains health-only.
CUSTOMER_AI_PROVIDER_RUNTIME_MODE=disabled
CUSTOMER_AI_ENVIRONMENT=local
CUSTOMER_AI_INTERNAL_SECURITY_ENABLED=false
CUSTOMER_AI_SERVICE_JWKS_URL=
CUSTOMER_AI_SUBJECT_ASSERTION_JWKS_URL=
CUSTOMER_AI_AUTH_TOKEN_BASE_URL=
CUSTOMER_AI_AUTH_CLIENT_ID=
CUSTOMER_AI_AUTH_CLIENT_SECRET=
CUSTOMER_AI_DEEPSEEK_API_KEY=
CUSTOMER_AI_KNOWLEDGE_CALLBACK_BASE_URL=
CUSTOMER_AI_SUMMARY_CALLBACK_BASE_URL=
CUSTOMER_AI_KNOWLEDGE_SOURCE_ALLOWED_HOSTS=[]
CUSTOMER_AI_CHROMA_PERSIST_DIRECTORY=
# Academy deployment only: production environment with persistent single-worker runtime.
# CUSTOMER_AI_PROVIDER_RUNTIME_MODE=academy
# CUSTOMER_AI_ENVIRONMENT=production
# CUSTOMER_AI_INTERNAL_SECURITY_ENABLED=true
# CUSTOMER_AI_RUNTIME_STATE_DIRECTORY=/data/runtime
# CUSTOMER_AI_CHROMA_PERSIST_DIRECTORY=/data/chroma
# Exact origin exceptions; HTTPS certificate verification remains enabled.
CUSTOMER_AI_HTTP_ALLOWED_ORIGINS=[]
CUSTOMER_AI_KNOWLEDGE_SOURCE_HTTP_ALLOWED_ORIGINS=[]
# Optional. Leave unset to return UNAVAILABLE for Subscription capabilities.
# CUSTOMER_AI_SUBSCRIPTION_CURRENT_STATE_BASE_URL=
# Optional Delivery integration: leave BOTH URL and key unset to return UNAVAILABLE.
# Direct service HTTPS origin, no path/query; never the public gateway.
# CUSTOMER_AI_DELIVERY_CURRENT_STATE_BASE_URL=https://delivery.internal
# Match Delivery's DELIVERY_CUSTOMER_AI_API_KEY (not an Auth client secret).
# CUSTOMER_AI_DELIVERY_CURRENT_STATE_API_KEY=replace-with-dedicated-delivery-key
# Only localhost/127.0.0.1/::1 HTTP may use this local-test exception.
CUSTOMER_AI_DELIVERY_CURRENT_STATE_ALLOW_LOOPBACK_HTTP=false
